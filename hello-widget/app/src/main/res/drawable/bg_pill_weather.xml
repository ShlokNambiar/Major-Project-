<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:startColor="#D9B9B0FF"
                android:endColor="#C49C92FA" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke android:width="2dp" android:color="#80E6E2FF" />
        </shape>
    </item>
</layer-list>
