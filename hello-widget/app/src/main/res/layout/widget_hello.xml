<?xml version="1.0" encoding="utf-8"?>
<!-- Text and pills are bitmaps drawn by WidgetArt (launchers ignore custom widget fonts). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1:  hello [● 09]  Thu -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/hello"
            android:layout_width="62dp"
            android:layout_height="28dp"
            android:contentDescription="hello"
            android:scaleType="fitCenter"
            android:src="@drawable/hello_script" />

        <ImageView
            android:id="@+id/date_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp" />

        <ImageView
            android:id="@+id/day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Row 2:  It's (clock) 6:15 PM ,  [22° ⛅] -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/its"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <AnalogClock
            android:id="@+id/analog"
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:layout_marginStart="6dp"
            android:dial="@drawable/clock_dial"
            android:hand_hour="@drawable/clock_hour"
            android:hand_minute="@drawable/clock_minute" />

        <ImageView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp" />

        <ImageView
            android:id="@+id/weather_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
